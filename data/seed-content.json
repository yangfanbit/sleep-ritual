      "source": "curated §6.1"
    },
    {
      "id": "q007",
      "type": "quote",
      "text": "不用咬牙，不用硬撑，不用打鸡血，不用骂自己，也不用自我感动。",
      "category": "CALM",
      "reasons": ["bad_mood"],
